---
/**
 * /go/spaylater — Redirect to SPayLater sign-up / activation link.
 *
 * Destination is read from src/config/spaylater.ts (destinationUrl only).
 * UTM params passed to this page are stored in localStorage for internal tracking
 * but are NOT appended to the Shopee destination URL.
 */
import { spayLaterConfig } from '../../config/spaylater';

const dest = spayLaterConfig.destinationUrl;
---

<!doctype html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>กำลังพาไปยัง SPayLater…</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta http-equiv="refresh" content={`0; url=${dest}`} />
  <style>
    body {
      font-family: 'Sarabun', sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      background: #f8fafc;
      color: #64748b;
      text-align: center;
    }
    .msg { max-width: 320px; }
    .msg p { margin: 0.5rem 0 0; font-size: 0.9rem; }
    .spinner {
      width: 32px; height: 32px;
      border: 3px solid #e2e8f0;
      border-top-color: #0d9488;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      margin: 0 auto 1rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      .spinner { animation: none; border-top-color: #0d9488; }
    }
  </style>
</head>
<body>
  <div class="msg">
    <div class="spinner"></div>
    <strong>กำลังพาไปยัง SPayLater</strong>
    <p>ถ้าหน้าไม่เปลี่ยน <a href={dest}>คลิกที่นี่</a></p>
  </div>

  <script define:vars={{ dest }}>
    (function () {
      // Log internal tracking data only — NOT appended to Shopee URL
      try {
        var p = new URLSearchParams(location.search);
        var entry = {
          ts:           new Date().toISOString(),
          utm_source:   p.get('utm_source')   || '',
          utm_medium:   p.get('utm_medium')   || '',
          utm_campaign: p.get('utm_campaign') || '',
          ref_page:     p.get('ref')          || document.referrer || 'direct',
        };
        var stored = JSON.parse(localStorage.getItem('spaylater_clicks') || '[]');
        stored.push(entry);
        localStorage.setItem('spaylater_clicks', JSON.stringify(stored.slice(-100)));
      } catch (_) {}

      // Redirect directly to destination — no UTM injection into Shopee URL
      location.replace(dest);
    })();
  </script>
</body>
</html>
