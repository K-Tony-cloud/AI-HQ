---
import BaseLayout from '../layouts/BaseLayout.astro';
const updated = '2026-07-08';
---

<BaseLayout
  title="นโยบายความเป็นส่วนตัว"
  description="นโยบายความเป็นส่วนตัวของเว็บไซต์ ซื้อไหนดี"
  breadcrumbs={[{ name: 'นโยบายความเป็นส่วนตัว', url: Astro.url.href }]}
>
  <div class="container" style="max-width:740px;padding-top:2rem;">
    <nav class="breadcrumb"><a href="/">หน้าแรก</a><span>นโยบายความเป็นส่วนตัว</span></nav>
    <h1>นโยบายความเป็นส่วนตัว</h1>
    <p style="color:var(--color-muted);font-size:0.9rem;">อัปเดตล่าสุด: {updated}</p>

    <h2>ข้อมูลที่เราเก็บรวบรวม</h2>
    <p>
      เว็บไซต์นี้ไม่เก็บข้อมูลส่วนบุคคลของผู้เข้าชม ไม่มีระบบสมาชิก ไม่มีการล็อกอิน
      และไม่มีการกรอกแบบฟอร์มที่ส่งข้อมูลถึงเรา
    </p>

    <h2>คุกกี้</h2>
    <p>
      เว็บไซต์นี้อาจใช้ Cloudflare Web Analytics ซึ่งเก็บข้อมูลการเข้าชมแบบไม่ระบุตัวตน
      เพื่อวัตถุประสงค์ในการปรับปรุงเนื้อหา ไม่มีการขายข้อมูลให้บุคคลที่สาม
    </p>

    <h2>ลิงก์ภายนอก</h2>
    <p>
      บทความของเราเชื่อมโยงไปยัง Shopee ซึ่งมีนโยบายความเป็นส่วนตัวของตนเอง
      เราไม่รับผิดชอบต่อการเก็บข้อมูลของเว็บไซต์ภายนอก
    </p>

    <h2>ติดต่อ</h2>
    <p>หากมีคำถามเกี่ยวกับนโยบายนี้ ติดต่อได้ที่ <a href="/contact">หน้าติดต่อ</a></p>
  </div>
</BaseLayout>
