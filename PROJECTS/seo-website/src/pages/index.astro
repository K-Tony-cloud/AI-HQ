---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allArticles = await getCollection('articles', ({ data }) => data.article_status === 'published');
const latest = allArticles
  .sort((a, b) => new Date(b.data.updated_at).getTime() - new Date(a.data.updated_at).getTime())
  .slice(0, 6);

const CATEGORIES = [
  { name: 'บ้านและครัว',         slug: 'home-living',    emoji: '🏠' },
  { name: 'มือถือ & แกดเจ็ต',    slug: 'mobile-gadgets', emoji: '📱' },
  { name: 'ความงาม',             slug: 'beauty',         emoji: '💄' },
  { name: 'สุขภาพ',              slug: 'health',         emoji: '💊' },
  { name: 'แม่และเด็ก',          slug: 'baby-kids',      emoji: '👶' },
  { name: 'กีฬา',                slug: 'sports',         emoji: '⚽' },
  { name: 'อาหาร & เครื่องดื่ม', slug: 'food-drinks',    emoji: '🍜' },
];
---

<BaseLayout
  title="ซื้อไหนดี — ศูนย์รวมคำแนะนำสินค้าจากข้อมูลจริง"
  description="เปรียบเทียบสินค้าและอ่านรีวิวจากข้อมูลยอดขายจริงบน Shopee ช่วยคุณตัดสินใจได้ง่ายขึ้น"
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1>ซื้อไหนดี?</h1>
      <p class="hero__sub">
        คำแนะนำสินค้าจากข้อมูลยอดขายและรีวิวจริงบน Shopee<br />
        ช่วยให้คุณเลือกสินค้าได้ถูกต้องและคุ้มค่า
      </p>
      <div>
        <a href="/category/home-living" class="btn btn--primary">ดูสินค้าแนะนำ</a>
        <a href="/about" class="btn btn--outline">เกี่ยวกับเรา</a>
      </div>

      <div class="trust-row">
        <div class="trust-item">
          <div class="trust-item__icon">📊</div>
          <div class="trust-item__label">ข้อมูลยอดขายจริง</div>
        </div>
        <div class="trust-item">
          <div class="trust-item__icon">⚖️</div>
          <div class="trust-item__label">เปรียบเทียบง่าย</div>
        </div>
        <div class="trust-item">
          <div class="trust-item__icon">🔄</div>
          <div class="trust-item__label">อัปเดตสม่ำเสมอ</div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <!-- Categories -->
    <section class="section">
      <h2 class="section-title">หมวดหมู่สินค้า</h2>
      <div class="category-grid">
        {CATEGORIES.map(cat => (
          <a href={`/category/${cat.slug}`} class="category-card">
            <span class="emoji">{cat.emoji}</span>
            {cat.name}
          </a>
        ))}
      </div>
    </section>

    <!-- Latest articles -->
    <section class="section">
      <h2 class="section-title">บทความล่าสุด</h2>

      {latest.length > 0 ? (
        <ul class="article-list">
          {latest.map(article => (
            <li class="article-list__item">
              <a href={`/${article.id}`} class="article-list__title">
                {article.data.title}
              </a>
              <div class="article-list__meta">
                {(article.data.subcategory_label || article.data.category_label) && (
                  <span>{article.data.subcategory_label || article.data.category_label} · </span>
                )}
                {new Date(article.data.updated_at).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' })}
              </div>
              {article.data.description && (
                <p class="article-list__excerpt">
                  {article.data.description.slice(0, 120)}
                </p>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <div class="empty-state__icon">📝</div>
          <p>กำลังเตรียมบทความคำแนะนำสินค้า — กลับมาใหม่เร็ว ๆ นี้</p>
        </div>
      )}
    </section>
  </div>

  <!-- Affiliate disclosure strip -->
  <div class="disclosure-strip">
    เว็บไซต์นี้เข้าร่วมโปรแกรม Shopee Affiliate — ลิงก์บางส่วนในบทความอาจทำให้เราได้รับค่าคอมมิชชัน
    โดยไม่มีผลต่อราคาสินค้าของคุณ &nbsp;<a href="/affiliate-disclosure">อ่านเพิ่มเติม</a>
  </div>
</BaseLayout>
