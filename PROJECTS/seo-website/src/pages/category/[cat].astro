---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const CATEGORIES = [
    { slug: 'home-living',    label: 'บ้านและครัว',          emoji: '🏠' },
    { slug: 'mobile-gadgets', label: 'มือถือ & แกดเจ็ต',     emoji: '📱' },
    { slug: 'beauty',         label: 'ความงาม',              emoji: '💄' },
    { slug: 'health',         label: 'สุขภาพ',               emoji: '💊' },
    { slug: 'baby-kids',      label: 'แม่และเด็ก',           emoji: '👶' },
    { slug: 'sports',         label: 'กีฬา',                 emoji: '⚽' },
    { slug: 'food-drinks',    label: 'อาหาร & เครื่องดื่ม',  emoji: '🍜' },
  ];

  const allArticles = await getCollection('articles', ({ data }) => data.article_status === 'published');

  return CATEGORIES.map(cat => ({
    params: { cat: cat.slug },
    props: {
      label: cat.label,
      emoji: cat.emoji,
      // category in frontmatter is already the canonical slug — exact match only
      articles: allArticles.filter(a =>
        a.data.category === cat.slug
      ).sort((a, b) => new Date(b.data.updated_at).getTime() - new Date(a.data.updated_at).getTime()),
    },
  }));
}

const { cat }              = Astro.params;
const { label, emoji, articles } = Astro.props;
---

<BaseLayout
  title={`${label} — คำแนะนำสินค้า`}
  description={`รวมคำแนะนำและรีวิวสินค้าหมวด ${label} จากข้อมูลยอดขายจริงบน Shopee`}
  breadcrumbs={[{ name: label, url: Astro.url.href }]}
>
  <!-- Category hero -->
  <section class="cat-hero">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">หน้าแรก</a>
        <span class="breadcrumb__sep">›</span>
        <span>{label}</span>
      </nav>
      <h1>{emoji} {label}</h1>
      <p>บทความคำแนะนำสินค้าหมวด {label} จากข้อมูลยอดขายจริง — {articles.length} บทความ</p>
    </div>
  </section>

  <div class="container">
    <div class="section">
      {articles.length > 0 ? (
        <ul class="article-list">
          {articles.map(article => (
            <li class="article-list__item">
              <a href={`/${article.id}`} class="article-list__title">
                {article.data.title}
              </a>
              <div class="article-list__meta">
                {new Date(article.data.updated_at).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' })}
              </div>
              {article.data.description && (
                <p class="article-list__excerpt">
                  {article.data.description.slice(0, 140)}
                </p>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-state">
          <div class="empty-state__icon">{emoji}</div>
          <p>กำลังเตรียมบทความหมวด {label} — กลับมาใหม่เร็ว ๆ นี้</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
