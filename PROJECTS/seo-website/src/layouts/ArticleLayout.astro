---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title:              string;
  description:        string;
  keyword:            string;
  category:           string;        // canonical slug e.g. 'mobile-gadgets'
  category_label?:    string;        // Thai display label e.g. 'มือถือ & แกดเจ็ต'
  subcategory_label?: string;        // subcategory display badge e.g. 'USB & Mobile Fans'
  slug:               string;
  createdAt:          string;
  updatedAt:          string;
  hasDisclosure:      boolean;
}

const { title, description, keyword, category, category_label, subcategory_label, slug, createdAt, updatedAt, hasDisclosure } = Astro.props;

const siteUrl    = import.meta.env.SITE || Astro.site?.toString() || 'http://localhost:4321';
const articleUrl = `${siteUrl}/${slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: articleUrl,
  datePublished: createdAt,
  dateModified:  updatedAt,
  publisher: {
    '@type': 'Organization',
    name: 'ซื้อไหนดี',
    url: siteUrl,
  },
  inLanguage: 'th',
};

// Canonical slug → Thai display label (same source of truth as [cat].astro CATEGORIES)
const CATEGORY_LABELS: Record<string, string> = {
  'home-living':    'บ้านและครัว',
  'mobile-gadgets': 'มือถือ & แกดเจ็ต',
  'beauty':         'ความงาม',
  'health':         'สุขภาพ',
  'baby-kids':      'แม่และเด็ก',
  'sports':         'กีฬา',
  'food-drinks':    'อาหาร & เครื่องดื่ม',
};

// category is already a canonical slug (e.g. 'mobile-gadgets') — no slug transformation needed
const catSlug    = category ?? '';
const catDisplay = CATEGORY_LABELS[catSlug] || category_label || catSlug || '';
const breadcrumbs = [
  ...(catSlug ? [{ name: catDisplay, url: `${siteUrl}/category/${catSlug}` }] : []),
  { name: title.slice(0, 60), url: articleUrl },
];

const updatedLabel = new Date(updatedAt).toLocaleDateString('th-TH', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={articleUrl}
  {articleSchema}
  {breadcrumbs}
>
  <div class="article-wrap">
    <div class="article-header">
      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/">หน้าแรก</a>
        {catSlug && (
          <>
            <span class="breadcrumb__sep">›</span>
            <a href={`/category/${catSlug}`}>{catDisplay}</a>
          </>
        )}
        {subcategory_label && catSlug && (
          <>
            <span class="breadcrumb__sep">›</span>
            <span class="breadcrumb__badge">{subcategory_label}</span>
          </>
        )}
        <span class="breadcrumb__sep">›</span>
        <span>{title.slice(0, 50)}</span>
      </nav>

      <!-- Disclosure banner -->
      {hasDisclosure && (
        <div class="disclosure-banner">
          บทความนี้มีลิงก์ Affiliate — เมื่อซื้อสินค้าผ่านลิงก์ ผู้เขียนอาจได้รับค่าคอมมิชชัน
          โดยไม่มีผลต่อราคาสินค้าสำหรับผู้ซื้อ <a href="/affiliate-disclosure">อ่านเพิ่มเติม</a>
        </div>
      )}

      <h1>{title}</h1>
      <div class="article-meta">อัปเดตล่าสุด: {updatedLabel}</div>
    </div>

    <article class="article-body">
      <slot />
    </article>

    <!-- Related links -->
    <div class="article-related">
      <a href="/">← กลับหน้าแรก</a>
      {catSlug && (
        <a href={`/category/${catSlug}`}>ดูสินค้าหมวด {catDisplay} →</a>
      )}
    </div>
  </div>
</BaseLayout>
