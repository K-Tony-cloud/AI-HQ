---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title:       string;
  description: string;
  keyword:     string;
  category:    string;
  slug:        string;
  createdAt:   string;
  updatedAt:   string;
  hasDisclosure: boolean;
}

const { title, description, keyword, category, slug, createdAt, updatedAt, hasDisclosure } = Astro.props;

const siteUrl    = import.meta.env.SITE || Astro.site?.toString() || 'http://localhost:4321';
const articleUrl = `${siteUrl}/${slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: articleUrl,
  datePublished: createdAt,
  dateModified:  updatedAt,
  publisher: {
    '@type': 'Organization',
    name: 'ซื้อไหนดี',
    url: siteUrl,
  },
  inLanguage: 'th',
};

const breadcrumbs = [
  ...(category ? [{ name: category, url: `${siteUrl}/category/${category.toLowerCase().replace(/\s+/g, '-')}` }] : []),
  { name: title.slice(0, 60), url: articleUrl },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={articleUrl}
  {articleSchema}
  {breadcrumbs}
>
  <div class="container" style="max-width:860px;">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" style="margin-top:1rem;">
      <a href="/">หน้าแรก</a>
      {category && (
        <span>
          <a href={`/category/${category.toLowerCase().replace(/\s+/g, '-')}`}>{category}</a>
        </span>
      )}
      <span>{title.slice(0, 50)}</span>
    </nav>

    <!-- Disclosure banner -->
    {hasDisclosure && (
      <div class="disclosure-banner">
        บทความนี้มีลิงก์ Affiliate — เมื่อซื้อสินค้าผ่านลิงก์ ผู้เขียนอาจได้รับค่าคอมมิชชัน
        โดยไม่มีผลต่อราคาสินค้าสำหรับผู้ซื้อ <a href="/affiliate-disclosure">อ่านเพิ่มเติม</a>
      </div>
    )}

    <h1 style="font-size:1.9rem;margin-top:0.5rem;">{title}</h1>

    <div style="font-size:0.85rem;color:var(--color-muted);margin-bottom:1.5rem;">
      อัปเดตล่าสุด: {new Date(updatedAt).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' })}
    </div>

    <article class="article-body">
      <slot />
    </article>

    <!-- Related links -->
    <div style="margin-top:2.5rem;padding-top:1.5rem;border-top:1px solid var(--color-border);font-size:0.9rem;">
      <a href="/">กลับหน้าแรก</a>
      {category && (
        <span style="margin-left:1rem;">
          <a href={`/category/${category.toLowerCase().replace(/\s+/g, '-')}`}>ดูสินค้าหมวด {category}</a>
        </span>
      )}
    </div>
  </div>
</BaseLayout>
