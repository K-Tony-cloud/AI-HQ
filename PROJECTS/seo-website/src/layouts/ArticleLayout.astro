---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title:         string;
  description:   string;
  keyword:       string;
  category:      string;
  slug:          string;
  createdAt:     string;
  updatedAt:     string;
  hasDisclosure: boolean;
}

const { title, description, keyword, category, slug, createdAt, updatedAt, hasDisclosure } = Astro.props;

const siteUrl    = import.meta.env.SITE || Astro.site?.toString() || 'http://localhost:4321';
const articleUrl = `${siteUrl}/${slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: articleUrl,
  datePublished: createdAt,
  dateModified:  updatedAt,
  publisher: {
    '@type': 'Organization',
    name: 'ซื้อไหนดี',
    url: siteUrl,
  },
  inLanguage: 'th',
};

const catSlug = category?.toLowerCase().replace(/\s+/g, '-') ?? '';
const breadcrumbs = [
  ...(category ? [{ name: category, url: `${siteUrl}/category/${catSlug}` }] : []),
  { name: title.slice(0, 60), url: articleUrl },
];

const updatedLabel = new Date(updatedAt).toLocaleDateString('th-TH', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={articleUrl}
  {articleSchema}
  {breadcrumbs}
>
  <div class="article-wrap">
    <div class="article-header">
      <!-- Breadcrumb -->
      <nav class="breadcrumb">
        <a href="/">หน้าแรก</a>
        {category && (
          <>
            <span class="breadcrumb__sep">›</span>
            <a href={`/category/${catSlug}`}>{category}</a>
          </>
        )}
        <span class="breadcrumb__sep">›</span>
        <span>{title.slice(0, 50)}</span>
      </nav>

      <!-- Disclosure banner -->
      {hasDisclosure && (
        <div class="disclosure-banner">
          บทความนี้มีลิงก์ Affiliate — เมื่อซื้อสินค้าผ่านลิงก์ ผู้เขียนอาจได้รับค่าคอมมิชชัน
          โดยไม่มีผลต่อราคาสินค้าสำหรับผู้ซื้อ <a href="/affiliate-disclosure">อ่านเพิ่มเติม</a>
        </div>
      )}

      <h1>{title}</h1>
      <div class="article-meta">อัปเดตล่าสุด: {updatedLabel}</div>
    </div>

    <article class="article-body">
      <slot />
    </article>

    <!-- Related links -->
    <div class="article-related">
      <a href="/">← กลับหน้าแรก</a>
      {category && (
        <a href={`/category/${catSlug}`}>ดูสินค้าหมวด {category} →</a>
      )}
    </div>
  </div>
</BaseLayout>
