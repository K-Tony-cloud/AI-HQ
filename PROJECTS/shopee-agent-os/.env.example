# ─────────────────────────────────────────────────────────────────────────────
# shopee-agent-os — Environment Variables
# Local: copy to .env and fill in values
# Render: set each variable in the Render dashboard (Environment tab)
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# ── DATA STORAGE ─────────────────────────────────────────────────────────────
# Local: leave unset — uses ./data/shopee.duckdb automatically
# Render: set DATA_DIR=/data  (matches the persistent disk mountPath in render.yaml)
# DATA_DIR=/data

# ── OPTIONAL: AI Content Generation ─────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── CONTROL CENTER ───────────────────────────────────────────────────────────
CHANNEL_CONTROL_CENTER=
CHANNEL_BOT_COMMANDS=

# ── DAILY INTELLIGENCE ───────────────────────────────────────────────────────
CHANNEL_MORNING_BRIEF=
CHANNEL_DAILY_PICKS=
CHANNEL_TREND_WATCH=
CHANNEL_VIRAL=

# ── CONTENT FACTORY ──────────────────────────────────────────────────────────
CHANNEL_CONTENT_QUEUE=
CHANNEL_APPROVED_CONTENT=

# ── AFFILIATE OPERATIONS ─────────────────────────────────────────────────────
CHANNEL_AFFILIATE_LINKS=
CHANNEL_MISSING_LINKS=
CHANNEL_LINK_COVERAGE=

# ── REVENUE & ANALYTICS ──────────────────────────────────────────────────────
CHANNEL_REVENUE=
CHANNEL_TOP_EARNERS=
CHANNEL_LEARNING_REPORTS=
CHANNEL_PROFIT=
CHANNEL_ANALYTICS=
CHANNEL_EXECUTIVE_SUMMARY=
CHANNEL_WEEKLY_REPORT=

# ── SYSTEM ───────────────────────────────────────────────────────────────────
CHANNEL_SYSTEM_LOG=
CHANNEL_SCHEDULER_LOG=
CHANNEL_BOT_STATUS=

# ── SCHEDULER ────────────────────────────────────────────────────────────────
# SCHEDULER_TIMEZONE=Asia/Bangkok
