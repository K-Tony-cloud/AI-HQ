# ─────────────────────────────────────────────────────────────────────────────
# shopee-agent-os — Discord Bot Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Required: Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Required for instant slash command registration during development.
# Your Discord Server (Guild) ID.  Right-click your server → Copy Server ID
# (Enable Developer Mode: User Settings → Advanced → Developer Mode)
DISCORD_GUILD_ID=your_guild_id_here

# ─────────────────────────────────────────────────────────────────────────────
# Optional: AI Content Generation
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Channel Routing
# Paste the channel ID for each section (right-click channel → Copy Channel ID)
# ─────────────────────────────────────────────────────────────────────────────
# CHANNEL_DAILY_PICKS=123456789
# CHANNEL_VIRAL=123456789
# CHANNEL_PROFIT=123456789
# CHANNEL_CONTENT_QUEUE=123456789
# CHANNEL_ANALYTICS=123456789
# CHANNEL_EXECUTIVE_SUMMARY=123456789
# CHANNEL_WEEKLY_REPORT=123456789

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Scheduler
# ─────────────────────────────────────────────────────────────────────────────
# SCHEDULER_TIMEZONE=Asia/Bangkok
