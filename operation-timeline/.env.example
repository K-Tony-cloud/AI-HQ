# ── API Mode ──────────────────────────────────────────────────────
# 'mock'  — use local mock data (default, no backend needed)
# 'live'  — hit Google Sheets via Apps Script
VITE_API_MODE=mock

# ── Google Apps Script Web App URL ────────────────────────────────
# Deploy apps-script/ as a Web App in Google Apps Script console.
# Execute as: Me | Who has access: Anyone
# Paste the deployed URL here (ends with /exec)
VITE_SHEETS_URL=

# ── Google Sheets Spreadsheet ID ──────────────────────────────────
# The spreadsheet ID from the URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# Also set as Script Property SPREADSHEET_ID inside Apps Script.
VITE_SHEETS_ID=

# ── Realtime Polling Interval ─────────────────────────────────────
# How often to poll for updates in live mode (milliseconds).
# Minimum recommended: 15000 (15s). Default: 30000 (30s).
VITE_POLL_INTERVAL=30000
